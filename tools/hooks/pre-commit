#!/bin/sh
# Hook partagé (Guet sur Mac, Bio sur Windows) : régénère la carte du code (docs/carte/) à chaque commit et l'ajoute au commit.
# Activation, une seule fois par copie du dépôt : git config core.hooksPath tools/hooks
# Ne bloque jamais le commit : si la génération échoue, un avertissement s'affiche.
cd "$(git rev-parse --show-toplevel)" || exit 0
if command -v py >/dev/null 2>&1; then PY=py; else PY=python3; fi
if $PY tools/gen_codemap.py >/dev/null 2>&1; then
  git add docs/carte
else
  echo "pre-commit : tools/gen_codemap.py a échoué, carte du code non mise à jour (le relancer à la main)." >&2
fi
exit 0
